{
  "framework": null,
  "installCommand": "true",
  "redirects": [
    {
      "source": "/stories/chips-into-russia/FINDINGS.md",
      "destination": "/stories/chips-into-russia/FINDINGS.html",
      "permanent": true
    },
    {
      "source": "/stories/shadow-fleet/FINDINGS.md",
      "destination": "/stories/shadow-fleet/FINDINGS.html",
      "permanent": true
    },
    {
      "source": "/stories/shadow-fleet/METHOD.md",
      "destination": "/stories/shadow-fleet/METHOD.html",
      "permanent": true
    },
    {
      "source": "/stories/shadow-fleet/README.md",
      "destination": "/stories/shadow-fleet/README.html",
      "permanent": true
    },
    {
      "source": "/stories/shadow-fleet/network/METHOD.md",
      "destination": "/stories/shadow-fleet/network/METHOD.html",
      "permanent": true
    },
    {
      "source": "/stories/sources/METHODS_LOG.md",
      "destination": "/stories/sources/METHODS_LOG.html",
      "permanent": true
    },
    {
      "source": "/stories/sources/RESEARCH_AND_SOURCES.md",
      "destination": "/stories/sources/RESEARCH_AND_SOURCES.html",
      "permanent": true
    },
    {
      "source": "/stories/who-lobbies/FINDINGS.md",
      "destination": "/stories/who-lobbies/FINDINGS.html",
      "permanent": true
    },
    {
      "source": "/stories/who-lobbies/clean-names-graph/FINDINGS.md",
      "destination": "/stories/who-lobbies/clean-names-graph/FINDINGS.html",
      "permanent": true
    },
    {
      "source": "/stories/who-lobbies/influence-network/README.md",
      "destination": "/stories/who-lobbies/influence-network/README.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/((?!stories/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/stories/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
